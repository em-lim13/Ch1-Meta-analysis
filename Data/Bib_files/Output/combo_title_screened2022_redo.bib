proceedings_title={Ifremer and Universite Nouvelle Caledonie and Institut de Recherche pour le Developpement (IRD) and Institut de Recherche pour le Developpement (IRD) and Universite de Toulon and Centre National de la Recherche Scientifique (CNRS) and Aix-Marseille Universite and Universite de Bretagne Occidentale and Centre National de la Recherche Scientifique (CNRS) and Ifremer and Institut de Recherche pour le Developpement (IRD)},
volume={8},
