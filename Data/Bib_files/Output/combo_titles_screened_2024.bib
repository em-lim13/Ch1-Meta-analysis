title={Global nutrient cycling by commercially targeted marine fish},
source={BIOGEOSCIENCES},
proceedings_title={Hospital Universitari Vall d'Hebron and Autonomous University of Barcelona and Institut Polytechnique de Paris and Ecole Polytechnique and Universite PSL and Ecole Normale Superieure (ENS) and Sorbonne Universite and University of California System and University of California Los Angeles and ICREA and McGill University},
