@ARTICLE{Whiteledge_1971_InvePesq_1,
type={ARTICLE},
author={Whiteledge, TE and Packard, T T},
title={Nutrient excretion by anchovies and zooplankton in Pacific upwelling regions},
journal={Invest. Pesq},
year={1971},
volume={35},
month={NA},
abstract={Peruvian anchovies (Engraulis ringens) excrete significant amounts of N in the form of ammonia, creatine, and urea. The ratio of N:P excreted by fish is less than that excreted by zooplankton, which in turn is smaller than the ratio of N:P contained in phytoplankton. Zooplankton excretion may be important in areas of mild upwelling, but it is probably not important in a strong upwelling region. Even if microzooplankton were included in the study, zooplankton excretion would not be significant in the Peru area. The biomass of the fish is much larger than that of zooplankton in the upwelling region, while their excretion rates are about equal. Using the exclusive production of creatine by fish as a method to distinguish between fish and zooplankton excretion, this study suggests that >1/3 of the ammonia found in a sample was due to fish excretion. Fish excretion may be a major source of nutrients for regenerated productivity in the Peru upwelling system. Better fish biomass estimates and more data on both fish and zooplankton excretion are needed to provide an improved estimate of the impact of fish on primary productivity in marine ecosystems.},
