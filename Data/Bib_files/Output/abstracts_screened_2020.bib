@ARTICLE{Higano_2005_JoofShRe,
type={ARTICLE},
author={Higano, Junya and Hirano, Keiji and Kitahara, Shigeru and Fujii, Akihiko},
title={Filtration and ammonia excretion of Manila clam, Ruditapes philippinarum, and their ecological impacts in Ariake Sound, Japan},
journal={Journal of Shellfish Research},
year={2005},
volume={24},
month={NA},
abstract={The Manila clam has been the most productive edible bivalve species in Japan. However, it has decreased during two decades and depleted most severely in Ariake Sound, with Japan's largest tidal flat. To estimate the ecological impact of Manila clams, clearance rate (Rc) of the clam for natural seawater and ammonia excretion rate (Rae) were determined in year-round measurements. We obtained an intercept of 0.979 and exponent of 0.27 for the allometric equation of Rc (liter/hour/dry soft tissue weight) and the temperature (C: Celsius) dependent relationship equation between Rc and Rae as Rae = (0.179 C - 0.518) x Rc ( mu mol-N/hr/gDW). We estimate that Manila clams in Ariake Sounds daily filtered 15-20% of daily water exchange (a billion kiloliter) above the tidal flat in spring tide (tidal rage is ca. 5 m) in the late 1970s with 60-80 thousand tons of annual catch. However, the rapid decline of the clams reduced this to 1-3% in 1990s. The relationship between Rc and Rae suggested that the clams could actively eliminate phytoplankton under higher phytoplankton density, inversely enhance algal growth under lower density. An ecological model including the clam's filtration and excretion predicted that 10,000 tons clams showed an unclear effect for controlling phytoplankton density whereas 100,000 tons clams showed obvious phytoplankton elimination. The present status of Manila clam population has little contribution to the ecosystem in Ariake Sound and thus the resurgence of the clam resources and the enhancement of other filter feeding bivalves are essential.},
