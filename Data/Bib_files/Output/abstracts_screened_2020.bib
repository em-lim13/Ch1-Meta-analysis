@ARTICLE{X.ISI.000260360900002,
type={ARTICLE},
author={Vinther, Hanne Fogh and Holmer, Marianne},
title={Experimental test of biodeposition and ammonium excretion from blue mussels (Mytilus edulis) on eelgrass (Zostera marina) performance},
