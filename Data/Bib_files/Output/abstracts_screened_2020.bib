@ARTICLE{Valdez_2020_FrinMaSc,
type={ARTICLE},
author={Valdez, Stephanie R and Zhang, Y Stacy and van der Heide, Tjisse and Vanderklift, Mathew A and Tarquinio, Flavia and Orth, Robert J and Silliman, Brian R},
