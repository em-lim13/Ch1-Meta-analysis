@ARTICLE{Hiromi_2005_BuofthPlSoofJa,
type={JOUR},
author={Hiromi, Juro and Kasuya, Tomoyuki and Ishii, Haruto},
title={Impacts of massive occurrence of jellyfish on pelagic ecosystem},
