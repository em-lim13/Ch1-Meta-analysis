@ARTICLE{Isla_2004_MariBiol_1,
type={JOUR},
author={Isla, JA and Ceballos, S and Huskin, I and Anadon, R and Alvarez-Marques, F},
title={Mesozooplankton distribution, metabolism and grazing in an anticyclonic slope water oceanic eddy (SWODDY) in the Bay of Biscay},
journal={Marine Biology},
year={2004},
