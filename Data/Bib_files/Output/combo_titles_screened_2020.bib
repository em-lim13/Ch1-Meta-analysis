@ARTICLE{X.ISI.000392332900022,
type={article},
author={Kohda, Masanori and Yamanouchi, Hiroko and Hirata, Tomonori and Satoh, Shun and Ota, Kazutaka},
title={A novel aspect of goby-shrimp symbiosis: gobies provide droppings in their burrows as vital food for their partner shrimps},
journal={MARINE BIOLOGY},
year={2017},
volume={164},
month={JAN},
abstract={The goby-shrimp symbiosis is a well-known example of mutualism among marine animals. It is generally accepted that the shrimp provides a sheltering burrow for the partner goby, and the goby warns its host about predatory risk. Other types of benefits between the participants are proposed, but most are based on anecdotal evidence. We propose the hypothesis that shrimps consume the gobies' droppings inside the burrow as their primary food source, based on preliminary field observations wherein gobies were never observed to defecate outside burrows despite frequent foraging, and partner shrimps were seldom observed eating outside burrows. We tested this hypothesis with a laboratory experiment conducted over a period of 2 weeks using the host shrimp Alpheus bellulus and its partner goby Amblyeleotris japonica. Our results were consistent with our predictions: (i) when a shrimp and a goby were kept together in a tank and only the goby was provided with food, the shrimp's body weight was maintained. (ii) When a shrimp was kept alone in a tank and was provided with the faeces of a goby kept in a different tank, the shrimp's body weight decreased slightly but was not significantly different from that of the shrimp in treatment (i). By contrast, when a shrimp was kept alone in a tank and given no food as control treatment, its body weight decreased much more than that of shrimps in the two treatments. These results together with field observations support the hypothesis that gobies provide faeces as a vital food source for shrimps; this is a novel finding in the study of this goby in their cooperative symbiosis. We suggest this food provisioning by goby for partner shrimp will be common in the shrimp-goby symbioses in coral reefs.},
