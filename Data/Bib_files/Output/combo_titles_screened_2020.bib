@ARTICLE{Fields_2014_EstCoaandSheSci_1,
type={JOUR},
author={Fields, Lindsey and Nixon, Scott W and Oviatt, Candace and Fulweiler, Robinson W},
title={Benthic metabolism and nutrient regeneration in hydrographically different regions on the inner continental shelf of Southern New England},
