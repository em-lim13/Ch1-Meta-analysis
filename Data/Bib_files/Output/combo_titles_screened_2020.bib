@ARTICLE{Gordon_2002_IsJoofAq,
type={JOUR},
author={Gordon, N and Neori, A and Harpaz, S and Shpigel, M},
title={Nutritional requirements of postlarvae of the Japanese abalone Haliotis discus hannai},
