@ARTICLE{James_1999_JoofSeReSeB.StanGlSt,
type={JOUR},
author={James, N P and Collins, L B and Bone, Y and Hallock, P},
title={Subtropical carbonates in a temperate realm: Modern sediments on the Southwest Australian Shelf},
