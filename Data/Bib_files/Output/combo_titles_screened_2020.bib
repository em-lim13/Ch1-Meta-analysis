@ARTICLE{Kreeger_1994_JoofShRe,
type={JOUR},
author={Kreeger, DA and Hawkins, AJS and Bayne, B L and Lowe, D L},
title={Seasonal variation in the relative utilization of dietary protein and carbohydrate by the mussel, Mytilus edulis L},
