@ARTICLE{X.ISI.A1997XB84000014,
type={article},
author={Pranal, V and FialaMedioni, A and Guezennec, J},
title={Fatty acid characteristics in two symbiont-bearing mussels from deep-sea hydrothermal vents of the south-western Pacific},
