author={Suzuki, MT and Sherr, EB and Sherr, BF},
title={Estimation of ammonium regeneration efficiencies associated with bacterivory in pelagic food webs via a N-15 tracer method},
journal={JOURNAL OF PLANKTON RESEARCH},
year={1996},
volume={18},
month={MAR},
abstract={Phagotrophic protists are major components of pelagic food webs, both as consumers of bacterial and phytoplankton cells, and as regenerators of inorganic nutrients. In this study, we estimated the efficiency of ammonium regeneration by protists feeding on bacteria within natural planktonic assemblages, using a N-15 tracer method, in which the excretion of N-15-labeled ammonium due to grazing on N-15 pre-labeled bacteria was followed over time. We tested this approach in experiments based on the addition of heat-killed N-15-labeled bacteria to laboratory cultures and to samples of coastal seawater. During two experiments, variation in abundance of bacterivores and bacterioplankton resulted in non-constant grazing rates. Deterministic computer models that used abundance of bacteria and protists as variables were developed to estimate best-fit values of grazing mortality (g, h(-1)) and of ammonium regeneration efficiency (R(E), fraction of the initial N-15 label in added bacteria which is released as ammonium). Estimated ammonium R(E) were 0.30-0.35 for one trophic link systems with both a monospecific culture and a mixed species assemblage of bacterivorous flagellates. R(E) was higher for multi-trophic step food webs: 0.60 for 5 mu m pre-screened coastal seawater and 0.90 for whole coastal seawater.},
