@ARTICLE{X.ISI.000285243000007,
type={article},
author={Collins, Lindsay B. and Testa, Viviane},
title={QUATERNARY DEVELOPMENT OF RESILIENT REEFS ON THE SUBSIDING KIMBERLEY CONTINENTAL MARGIN, NORTHWEST AUSTRALIA},
