@ARTICLE{X.ISI.A1993ME14700006,
type={article},
author={JANSSON, M},
title={UPTAKE, EXCHANGE, AND EXCRETION OF ORTHOPHOSPHATE IN PHOSPHATE-STARVED SCENEDESMUS-QUADRICAUDA AND PSEUDOMONAS K7},
