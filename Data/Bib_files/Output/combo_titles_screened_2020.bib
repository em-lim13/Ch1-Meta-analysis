@ARTICLE{Carmouze_2001_AEH.M,
type={JOUR},
author={Carmouze, J-P and Domingos, P},
title={Physical variables, carbon cycling and primary producer couplings in a shallow tropical lagoon (Barra Lagoon, Brazil)},
