@ARTICLE{Hassler_2012_Ocanmabiananre,
type={JOUR},
author={Hassler, C S and Schoemann, V and Boye, M and Tagliabue, A and Rozmarynowycz, M and McKay, RML},
title={Iron bioavailability in the Southern Ocean},
