@ARTICLE{Isla_2004_JoofPlRe_1,
type={JOUR},
author={Isla, JA and Llope, M and Anadon, R},
title={Size-fractionated mesozooplankton biomass, metabolism and grazing along a 50 degree N-30 degree S transect of the Atlantic Ocean},
