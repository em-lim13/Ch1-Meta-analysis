@ARTICLE{Cook_2007_AquaMicrEcol,
type={JOUR},
author={Cook, Perran LM and Veuger, Bart and Boeer, Simone and Middelburg, Jack J},
title={Effect of nutrient availability on carbon and nitrogen incorporation and flows through benthic algae and bacteria in near-shore sandy sediment},
journal={Aquatic Microbial Ecology},
year={2007},
volume={49},
month={NA},
abstract={Carbon and nitrogen uptake in a microbial community comprising bacteria and microalgae in a sandy marine sediment under nutrient-limited and -replete conditions was studied using a mesocosm approach. After 2 wk of incubation, a pulse of H super(13)CO sub(3) super(-) and super(15)NH sub(4) super(+) was added to the mesocosms, and subsequent uptake of super(13)C and super(15)N by bacteria and microphytobenthos (MPB) was traced by analysis of super(13)C and super(15)N incorporation into hydrolysable amino acids, including the bacterial biomarker d-alanine. The results confirm that MPB communities are capable of sustained high rates of photosynthesis despite nutrient limitation. Under these conditions cellular growth stops (as defined by the synthesis of chlorophyll a and amino acids) and the carbon fixed under such conditions consists predominantly of carbohydrates produced through 'overflow metabolism'. In the treatment with nutrient addition, algal growth was stimulated and label incorporation was more balanced, with carbohydrates accounting for a much smaller fraction of newly fixed organic carbon. There was close agreement between net C fixation based on O sub(2) fluxes and the increase of particulate organic carbon in the sediment under both nutrient- limited and -replete conditions. This finding suggests that very little fixed C was lost to the water column as dissolved organic carbon (DOC), consistent with direct measurements of DOC release using super(14)C. There was a significant and rapid transfer of super(13)C from the MPB to bacterial biomass in both treatments within 24 h of label addition, revealing that fixed carbon excreted by MPB was rapidly utilised by bacteria. In both treatments, bacteria incorporated a significant fraction of super(15)N from super(15)NH sub(4) super(+), with the greatest incorporation being observed under nutrient-limited conditions.},
