@ARTICLE{Lomas_2000_JoofPh,
type={JOUR},
author={Lomas, M W and Glibert, P M},
title={Comparisons of nitrate uptake, storage, and reduction in marine diatoms and flagellates},
journal={Journal of Phycology},
year={2000},
volume={36},
month={NA},
abstract={Diatoms, but not flagellates, have been shown to increase rates of nitrogen release after a shift from a low growth irradiance to a much higher experimental irradiance. We compared NO sub(3) super(-) uptake kinetics, internal inorganic nitrogen storage, and the temperature dependence of the NO sub(3) super(-) reduction enzymes, nitrate (NR) and nitrite reductase (NiR), in nitrogen-replete cultures of 3 diatoms (Chaetoceros sp., Skeletonema costatum, Thalassiosira weissflogii) and 3 flagellates (Dunaliella tertiolecta, Pavlova lutheri, Prorocentrum minimum) to provide insight into the differences in nitrogen release patterns observed between these species. At NO sub(3) super(-) concentrations <40 mu mol-N.L super(-) super(1), all the diatom species and the dinoflagellate P. minimum exhibited saturating kinetics, whereas the other flagellates, D. tertiolecta and P. lutheri, did not saturate, leading to very high estimated K sub(s) values. Above similar to 60 mu mol-N.L super(-) super(1), NO sub(3) super(-) uptake rates of all species tested continued to increase in a linear fashion. Rates of NO sub(3) super(-) uptake at 40 mu mol-N.L super(-) super(1), normalized to cellular nitrogen, carbon, cell number, and surface area, were generally greater for diatoms than flagellates. Diatoms stored significant amounts of NO sub(3) super(-) internally, whereas the flagellate species stored significant amounts of NH sub(4) super(+). Half-saturation concentrations for NR and NiR were similar between all species, but diatoms had significantly lower temperature optima for NR and NiR than did the flagellates tested in most cases. Relative to calculated biosynthetic demands, diatoms were found to have greater NO sub(3) super(-) uptake and NO sub(3) super(-) reduction rates than flagellates. This enhanced capacity for NO sub(3) super(-) uptake and reduction along with the lower optimum temperature for enzyme activity could explain differences in nitrogen release patterns between diatoms and flagellates after an increase in irradiance.},
