@ARTICLE{Yu_1998_OcLiSiYuHu,
type={JOUR},
author={Yu, Zhiming and Subba Rao, DV},
title={Impact of halloysite on growth of Psuedonitzschia pungens F. multiseries and production of algal toxin},
