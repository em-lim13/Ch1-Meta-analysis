@ARTICLE{van.Broekhoven_2015_MariEcolProgSeri,
type={JOUR},
author={van Broekhoven, Wouter and Jansen, Henrice and Verdegem, Marc and Struyf, Eric and Troost, Karin and Lindeboom, Han and Smaal, Aad},
