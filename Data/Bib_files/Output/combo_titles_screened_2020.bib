@ARTICLE{X.ISI.000544550000026,
type={article},
author={Wooldridge, Scott A.},
title={Excess seawater nutrients, enlarged algal symbiont densities and bleaching sensitive reef locations: 1. Identifying thresholds of concern for the Great Barrier Reef, Australia},
journal={MARINE POLLUTION BULLETIN},
year={2020},
volume={152},
month={MAR},
abstract={Here, I contribute new insight into why excess seawater nutrients are an increasingly identified feature at reef locations that have low resistance to thermal stress. Specifically, I link this unfavourable synergism to the development of enlarged (suboptimal) zooxanthellae densities that paradoxically limit the capacity of the host coral to build tissue energy reserves needed to combat periods of stress. I explain how both theoretical predictions and field observations support the existence of species-specific `optimal' zooxanthellae densities similar to 1.0-3.0 x 10(6) cells cm-(2). For the central Great Barrier Reef (GBR), excess seawater nutrients that permit enlarged zooxanthellae densities beyond this optimum range are linked with seawater chlorophyll a > 0.45 mu g-L-1; a eutrophication threshold previously shown to correlate with a significant loss in species for hard corals and phototrophic octocorals on the central GBR, and herein shown to correlate with enhanced bleaching sensitivity during the 1998 and 2002 mass bleaching events. (C) 2016 Elsevier Ltd. All rights reserved.},
