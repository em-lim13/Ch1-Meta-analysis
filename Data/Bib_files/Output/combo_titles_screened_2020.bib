@ARTICLE{X.ISI.000246407100005,
type={article},
author={Meseck, Shannon L. and Smith, Barry C. and Wikfors, Gary H. and Alix, Jennifer H. and Kapareiko, Diane},
title={Nutrient interactions between phytoplankton and bacterioplankton under different carbon dioxide regimes},
journal={JOURNAL OF APPLIED PHYCOLOGY},
year={2007},
volume={19},
month={JUN},
abstract={Light, nutrients, temperature, pH, and salinity are important factors in controlling the growth of phytoplankton and bacterioplankton. Supply of key nutrients to these communities can result in mutualistic or competitive relationships between bacterioplankton and phytoplankton. In this study, we investigated growth and uptake of nutrients by the marine prasinophyte flagellate Tetraselmis chui (strain PLY429) in the presence and absence of a community of bacterioplankton at two pH levels. Growth of PLY429 and total nutrient uptake were calculated for each treatment. The addition of bacterioplankton resulted in lower growth rates of PLY429, but the removal of ammonium was greater in those cultures with bacterioplankton present. The division rate of PLY429 was affected by pH; however, pH changes did not result in different uptake rates of nitrate, ammonium, or phosphate by the mixed algal and bacterial assemblage. These findings suggest that bacterioplankton and phytoplankton were competing for ammonium and that a lower pH resulted in more rapid algal growth.},
