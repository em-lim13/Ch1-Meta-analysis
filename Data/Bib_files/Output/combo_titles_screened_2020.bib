@ARTICLE{Umezawa_2007_JoofPh,
type={JOUR},
author={Umezawa, Yu and Miyajima, Toshihiro and Tanaka, Yasuaki and Koike, Isao and Hayashibara, Takeshi},
title={Variation in internal delta super(15)N and delta super(13)C distributions and their bulk values in the brown macroalga Padina australis growing in subtropical oligotrophic waters},
journal={Journal of Phycology},
year={2007},
volume={43},
month={NA},
abstract={The utility of delta super(15)N measurements in Padina australis Hauck as a probe for its external nitrogen (N) sources was tested by monitoring the bulk values of chemical components [ delta super(15)N, delta super(13)C, and N and carbon (C) contents] and their internal distributions during a 12 d incubation in a controlled environment. Under the saturated conditions of isotopically heavier nitrate than that of original algal tissue, the bulk delta super(15)N in P. australis was enriched, but less than what was predicted from a simple mixing model, signaling possible isotopic discrimination during N assimilation and subsequent N efflux from the cells. The enhanced N content (%), which occurred simultaneously with this delta super(15)N shift, was a useful signal indicating this phenomenon. Bulk delta super(15)N was enriched, especially around the meristem, in tissues growing under conditions of higher irradiance and temperature, probably due in part to dissolved organic nitrogen (DON) excretion. The delta super(13)C enhancement in bulk algal tissues, also associated with high photosynthetic activity, may be an additional signal indicating this unbalanced internal delta super(15)N distribution. However, in summer and winter environmental conditions with periodic nitrate supplies simulating typical fringing reef waters, the difference in measured algal bulk delta super(15)N from theoretical predictions was within plus or minus 1.0ppt. This difference is very small compared with the variation in delta super(15)N in possible N sources in coastal areas. In the field, therefore, delta super(15)N in Padina can be used effectively to trace N sources in both space and time after determining algal N content and delta super(13)C to determine whether large alterations occur in algal delta super(15)N.},
