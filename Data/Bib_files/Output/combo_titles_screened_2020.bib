@ARTICLE{Li_2012_FishScieKexu,
type={JOUR},
author={Li, Jie and Lie, Chi-Zhou and Chen, Wei-Zhou},
title={Mutually Beneficial Mechanism in Nanao Polyculture of Oyster(Crassostrea gigas) and Kelp(Gracilaria lemaneiformis) in Nanao, Guangdong Province},
