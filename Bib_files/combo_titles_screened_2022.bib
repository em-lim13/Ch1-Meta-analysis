author={Dworczak, Patrycja G and Berkowski, Baej and Jakubowicz, Micha},
title={Epizoans immured in the heterocoral <i>Oligophylloides maroccanus</i> Weyer, 2017: a unique record from the Famennian (Upper Devonian) of Morocco},
journal={Lethaia},
