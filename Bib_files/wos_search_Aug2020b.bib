   Perez-Llorens, Jose Lucas/B-9361-2009
   Vergara, Juan J/H-9808-2012
   Hernandez, Ignacio/N-2942-2013}},
ORCID-Numbers = {{Perez-Llorens, Jose Lucas/0000-0003-2813-1443
   Tovar-Sanchez, Antonio/0000-0003-4375-1982
   Perez-Llorens, Jose Lucas/0000-0003-2813-1443
