@article{ ISI:000327395400004,
Author = {Keesing, John K. and Strzelecki, Joanna and Fromont, Jane and Thomson,
   Damian},
Title = {{Sponges as important sources of nitrate on an oligotrophic continental
   shelf}},
Journal = {{LIMNOLOGY AND OCEANOGRAPHY}},
Year = {{2013}},
Volume = {{58}},
Number = {{6}},
Pages = {{1947-1958}},
Month = {{NOV}},
Abstract = {{In situ field measurements of dissolved inorganic nitrogen (DIN) release
   by sponges in southwestern Australia revealed nitrate release rates of
   0.022 to 0.743 mu mol g dry weight(-1) (dry wt) h(-1) and ammonium
   release rates of between 0.002 and 1.366 mu mol g dry wt(-1) h(-1). The
   highest and most consistent rates of nitrate release were among the
   Thorectidae (0.324 to 0.725 mu mol g dry wt(-1) h(-1)), while mycalid
   and verongid sponges were highly variable (0.024 to 0.743 mu mol g dry
   wt(-1) h(-1)). The ratio of nitrate to ammonium in released nitrogen
   ranged from 0.1 to 197.0, indicating a wide range of nitrogen release
   modes by sponges, from predominantly ammonium to very efficient nitrate
   producers. The study more than doubles the number of temperate sponge
   species recorded to release nitrate. Nutrient concentrations near the
   seabed sponge assemblages were higher at low wind speed (a proxy for
   turbulent mixing). These observations and our measurements of nitrogen
   release rates from sponges are consistent with the hypothesis that
   primary production in the region depends on wave-induced mixing at the
   seabed for resupply of remineralized nitrogen to a nutrient-impoverished
   water column and that sponges make an important contribution to these
   fluxes. Based on known biomass of sponges in southwestern Australia, we
   calculate that sponges may contribute DIN of 1.8 to 3.2 g N m(2) yr(-1).
   Taking into account the distribution of sponge habitat across the
   continental shelf to 100 m depth, this constitutes a contribution of
   10\% to 18\% of the total recycled nitrogen flux required from the
   benthos to balance a regional nitrogen budget.}},
DOI = {{10.4319/lo.2013.58.6.1947}},
ISSN = {{0024-3590}},
EISSN = {{1939-5590}},
ResearcherID-Numbers = {{Keesing, John/B-1955-2009
   Strzelecki, Joanna/E-5637-2012
   Thomson, Damian P/C-3047-2014
   }},
ORCID-Numbers = {{Keesing, John/0000-0002-0876-2144
   Thomson, Damian/0000-0001-5485-1562}},
Unique-ID = {{ISI:000327395400004}},
